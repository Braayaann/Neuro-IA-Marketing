# Copia como .env y usa valores propios. No subas credenciales a Git.
# En local se genera automáticamente en .local/secret-key si queda vacía.
SECRET_KEY=
APP_ENV=development
VISION_ENABLED=1
HOST=127.0.0.1
PORT=5000
